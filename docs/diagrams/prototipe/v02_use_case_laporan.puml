@startuml v02_use_case_laporan
title Use Case Diagram Prototipe v0.2

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 300
skinparam defaultFontName "Calibri"
skinparam defaultFontSize 13
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam ArrowFontSize 11
skinparam nodesep 12
skinparam ranksep 95
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontColor #000000
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
  BorderThickness 1
  FontColor #000000
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #555555
  FontColor #000000
}
skinparam note {
  BackgroundColor #F2F2F2
  BorderColor #555555
  FontColor #000000
  FontSize 12
}
left to right direction

actor "Admin" as ADMIN
actor "Staf" as STAF
actor "Manager" as MGR
actor "Owner" as OWN

rectangle "Sistem Prototipe v0.2" {
  usecase "Login" as UC_LOGIN
  usecase "Logout" as UC_LOGOUT
  usecase "Lihat dashboard" as UC_DASH
  usecase "Kelola data pengguna" as UC_USER
  usecase "Activity log" as UC_LOG
  usecase "Input transaksi" as UC_INPUT
  usecase "Hapus transaksi" as UC_HAPUS
  usecase "Kelola master akun" as UC_COA
  usecase "Lihat laporan keuangan" as UC_LAP
  usecase "Lihat arsip laporan" as UC_ARS
  usecase "Membuat pengajuan barang" as UC_BUAT
  usecase "Melihat status pengajuan" as UC_STATUS
  usecase "Lihat pengajuan barang" as UC_LIHATPB
  usecase "Setujui pengajuan pengadaan" as UC_ACC1
  usecase "Setujui akhir pengajuan pengadaan" as UC_ACC2
  usecase "Tolak pengajuan barang" as UC_TOLAKPB
  usecase "Generate nomor nota" as UC_NOTA
  usecase "Ekspor pengajuan CSV" as UC_CSV
}

ADMIN -- UC_LOGIN
ADMIN -- UC_LOGOUT
ADMIN -- UC_DASH
ADMIN -- UC_USER
ADMIN -- UC_LOG

STAF -- UC_LOGIN
STAF -- UC_LOGOUT
STAF -- UC_DASH
STAF -- UC_BUAT
STAF -- UC_STATUS
STAF -- UC_CSV

UC_LOGIN -- MGR
UC_LOGOUT -- MGR
UC_DASH -- MGR
UC_INPUT -- MGR
UC_HAPUS -- MGR
UC_COA -- MGR
UC_LAP -- MGR
UC_ARS -- MGR
UC_LIHATPB -- MGR
UC_ACC1 -- MGR
UC_TOLAKPB -- MGR
UC_CSV -- MGR

UC_LOGIN -- OWN
UC_LOGOUT -- OWN
UC_DASH -- OWN
UC_LOG -- OWN
UC_LAP -- OWN
UC_ARS -- OWN
UC_LIHATPB -- OWN
UC_ACC2 -- OWN
UC_TOLAKPB -- OWN
UC_CSV -- OWN

UC_ACC1 ..> UC_NOTA : <<include>>

note as N1
  Seluruh use case mensyaratkan pengguna telah login.
  Data akun, transaksi, dan pengajuan pembelian pada
  versi ini disimpan di peramban pengguna, belum di
  basis data server.
  Isi halaman Lihat arsip laporan masih berupa data
  contoh.
  Pembatasan akses baru diterapkan pada menu dan
  halaman di frontend; backend belum memeriksa peran.
end note

@enduml
