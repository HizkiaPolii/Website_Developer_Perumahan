# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dokumen skripsi & HKI (pribadi, tidak diperlukan untuk build)
/docs/*.docx
/docs/*.pdf
/docs/KONTEKS_BAB_IV.md
/docs/Draft_Contoh_Ciptaan.md

# gambar hasil bangkitan (dapat dibuat ulang dari berkas sumbernya)
/docs/diagrams/**/*.png
/docs/diagrams/arsip-barker
